# =====================================================================
# AZ Rental Guy - Plesk Production MariaDB Environment Variables
# Copy these values into your Plesk Node.js Environment Variables panel
# =====================================================================

# Option A: Full Connection String (Standard MariaDB / MySQL URL)
DATABASE_URL="mysql://wp_umtys:YOUR_PASSWORD_HERE@localhost:3306/wp_jzmwt"

# Option B: Individual Database Parameters
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="wp_umtys"
DB_PASSWORD="YOUR_PASSWORD_HERE"
DB_NAME="wp_jzmwt"

# Production Mode
NODE_ENV="production"
PORT=3000

